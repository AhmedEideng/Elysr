# ============================================================
# Elysr Medical — Environment Variables
# ============================================================
# المتغيرات المطلوبة لتشغيل المشروع (Vercel أو نشر ذاتي)
# ============================================================

# ── مطلوب ──────────────────────────────────────────────────────
# رابط Google Apps Script Web App لاستقبال الطلبات والمراجعات
# (في محرر Apps Script: Deploy → Web app → URL)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/replace-with-deployment-id/exec

# URL الموقع الرسمي (canonical + OG tags + feeds)
SITE_URL=https://elysrmedical.store

# ── مطلوب لتفعيل المراجعات الحقيقية ───────────────────────────
# مفتاح HMAC لقراءة المراجعات — يجب أن يطابق حرفياً قيمة
# REVIEW_READ_TOKEN في google-apps-script.gs (نفس السلسلة في الطرفين)
# بدونها: قسم "تجارب حقيقية من عملائنا" معطّل بصمت (fail-closed)
# والموقع يعمل طبيعيًا
GOOGLE_SHEETS_REVIEWS_TOKEN=replace-with-the-same-value-as-REVIEW_READ_TOKEN

# ── اختياري ───────────────────────────────────────────────────
# سر كتابة مشترك للـ webhook — يجب أن يطابق WEBHOOK_SECRET في
# google-apps-script.gs (نفس السلسلة في الطرفين). بدونه يظل
# مسار الكتابة بالوضع القديم (تحقق + rate limit فقط)
# GOOGLE_SHEETS_WEBHOOK_SECRET=replace-if-enabling-write-secret

# منفذ أخطاء متوافق مع Sentry (بدونه: console فقط في dev)
# VITE_ERROR_SINK_URL=

# Port — للنشر الذاتي فقط (الافتراضي 8080)
# PORT=8080

# ── سكريبتات CI/محلية فقط — لا يحتاجها Vercel ────────────────
# مفتاح Gemini لخط توليد المقالات وفحص دعم الادعاءات بالمصادر
# GEMINI_API_KEY=
