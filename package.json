{
  "name": "elysr-health-hub",
  "version": "2.0.0",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.mjs",
    "build": "vite build && node scripts/prerender-seo.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "sync:redirects": "node scripts/sync-vercel-redirects.mjs",
    "test": "node scripts/data-integrity.test.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:schemas": "node scripts/validate-schemas.mjs",
    "test:sources": "node scripts/validate-article-sources.mjs",
    "test:all": "npm run test && npm run test:unit && npm run build && npm run test:schemas",
    "prepare": "husky || true",
    "ci": "npm run lint && npm run typecheck && npm run test:all",
    "audit:deps": "npm audit --audit-level=high",
    "audit:perf": "lhci autorun --config=.lighthouserc.json || echo 'Run npm i -g @lhci/cli first'",
    "start": "node server/index.js",
    "start:dev": "node --watch server/index.js",
    "build:ssr": "npm run build && npm run prerender",
    "prerender": "node scripts/prerender-seo.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.21",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "fuse.js": "^7.5.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tanstack/router-plugin": "^1.168.26",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.1.0",
    "lucide-react": "^1.29.0",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "24.x"
  }
}
